// Tang Mega 138K Pro official audio_sinewave example pinout.
IO_LOC "HP_DIN" G24;
IO_PORT "HP_DIN" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "HP_WS" F24;
IO_PORT "HP_WS" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "HP_BCK" E22;
IO_PORT "HP_BCK" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "reset_n" K16;
IO_PORT "reset_n" PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "clk" P16;
IO_PORT "clk" PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

// Board USB/JTAG bridge BL616_TX -> FPGA DBG_UART.RX (schematic net N16).
// Idle-high pull-up prevents an unplugged/debug-reset bridge from forming bytes.
IO_LOC "uart_rx_i" N16;
IO_PORT "uart_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

// S1/S2 from the official key_led example.  Keys are active low.
IO_LOC "key_next_n" G15;
IO_PORT "key_next_n" PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "key_pluck_n" F15;
IO_PORT "key_pluck_n" PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

// J23 SDRAM CONN is used as GPIO only when no SDRAM module is attached.
// ESP32-S3 SPI master. IRQ and READY are optional on the ESP side.
// Trigger mode is selected by command 09; physical toggle inputs are not required.
// J23 pin 11 = +5V (LCD VCC), pin 12 = GND. Do not use +5V as a logic level.
// LCD LED is driven at 3.3V from J23 pin 6.
IO_LOC "lcd_sck" U16;
IO_PORT "lcd_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_sda" V16;
IO_PORT "lcd_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_cs_n" U15;
IO_PORT "lcd_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_dc" V17;
IO_PORT "lcd_dc" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_rst_n" W21;
IO_PORT "lcd_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lcd_led" Y21;
IO_PORT "lcd_led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

